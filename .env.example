# Caminho opcional para arquivo de ambiente.
# Se vazio, o projeto tenta carregar .env na raiz do bot_api.
BOT_ENV_FILE=.env

APP_HOST=127.0.0.1
APP_PORT=8080
BOT_API_BIND_IP=127.0.0.1
EVOLUTION_API_BIND_IP=127.0.0.1
PUBLIC_WEBHOOK_BIND_IP=127.0.0.1
PUBLIC_WEBHOOK_PORT=8090
PUBLIC_WEBHOOK_RATE_LIMIT_RPM=60
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
WEBHOOK_WORKER_THREADS=4
API_AUTH_ENABLED=1
API_AUTH_TOKENS=
API_REQUIRE_ADMIN_FOR_NUMBER=1

POSTGRES_USER=evolution
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=evolution
BOT_DATABASE_USER=bot_api
BOT_DATABASE_PASSWORD=change-me-bot-db-password
BOT_REPORTS_DATABASE_USER=bot_reports_read
BOT_REPORTS_DATABASE_PASSWORD=change-me-bot-reports-read-password

EVOLUTION_BASE_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_API_KEYS=
EVOLUTION_WEBHOOK_ALLOW_API_KEY_FALLBACK=0
# Use a instancia Evolution atual em producao.
# Exemplo para subir agora e migrar depois: bot-api-real
EVOLUTION_INSTANCE=
# Preencha apenas quando houver dominio publico HTTPS real.
EVOLUTION_SERVER_URL=
# Token de validacao do webhook da Meta na Evolution.
# So e necessario quando a Cloud API estiver em uso.
EVOLUTION_WA_BUSINESS_TOKEN_WEBHOOK=
EVOLUTION_SEND_PATH=/message/sendText/{instance}
EVOLUTION_LIST_PATH=/message/sendList/{instance}
EVOLUTION_BUTTONS_PATH=/message/sendButtons/{instance}
EVOLUTION_MEDIA_PATH=/message/sendMedia/{instance}
EVOLUTION_TIMEOUT_SECONDS=20
META_CLOUD_ENABLED=0
META_CLOUD_API_VERSION=v23.0
META_CLOUD_PHONE_NUMBER_ID=
META_CLOUD_ACCESS_TOKEN=
META_CLOUD_VERIFY_TOKEN=
META_CLOUD_APP_SECRET=
EVOLUTION_CLOUDAPI_HML_INSTANCE=bot-api-cloud-hml
EVOLUTION_CLOUDAPI_NUMBER_ID=
EVOLUTION_CLOUDAPI_BUSINESS_ID=
# Token permanente da Meta. Deixe vazio enquanto a Cloud API nao estiver ativa.
EVOLUTION_CLOUDAPI_PERMANENT_TOKEN=
# URL publica HTTPS para a Evolution chamar o bot. Deixe vazio enquanto a Cloud API nao estiver ativa.
EVOLUTION_CLOUDAPI_INSTANCE_WEBHOOK_URL=
PUBLIC_META_WEBHOOK_RATE_LIMIT_RPM=300
UPSTREAM_META_HOST=evolution-api
UPSTREAM_META_PORT=8080

BOT_VERIFY_TOKEN=change-me-webhook-token

ACCESS_CONTROL_ENABLED=1
ACCESS_DATABASE_URL=postgresql://bot_api:change-me-bot-db-password@HOST:5432/evolution
ACCESS_DB_SCHEMA=bot_access
ACCESS_PUBLIC_ENABLED=0
ACCESS_DATABASE_TIMEOUT_SECONDS=3
SECURITY_AUDIT_ENABLED=1
DENIED_REPLY_COOLDOWN_MINUTES=360
DENIED_UNREGISTERED_REPLY_COOLDOWN_MINUTES=720
ADMIN_API_TOKEN=change-me-admin-token
# Tokens do painel para financeiro. Formato: token:filial|filial,token2:filial
# Grupos sugeridos:
# Sousa e Itaporanga: 1|2
# Patos e Sume: 3|4
# Guarabira: 5
# Bahia: 6|7|8
# Exemplo: FINANCE_PANEL_TOKENS=fintok_sousa_itaporanga_xxx:1|2,fintok_patos_sume_xxx:3|4,fintok_guarabira_xxx:5,fintok_bahia_xxx:6|7|8
FINANCE_PANEL_TOKENS=
ADMIN_UPLOAD_MAX_FILE_SIZE_MB=300
ADMIN_UPLOAD_MAX_FILE_COUNT=20

REPORTS_DATABASE_URL=postgresql://evolution:change-me-postgres-password@HOST:5432/evolution
REPORTS_RUNTIME_DATABASE_URL=postgresql://bot_reports_read:change-me-bot-reports-read-password@HOST:5432/evolution
REPORTS_DB_SCHEMA=reports

PAYIP_BASE_URL=https://api.prod.payip.com.br
PAYIP_CLIENT_ID=payip-auth-portal
PAYIP_USERNAME=
PAYIP_PASSWORD=
PAYIP_COMPANY_ID=bdfee22b-ac11-4355-909a-54bd348c87cc
# Mapa filial:companyId. Mantem o mesmo codigo das filiais do bot.
# 3=Patos, 4=Sume. Adicione novas revendas no mesmo formato.
PAYIP_COMPANY_IDS=3:bdfee22b-ac11-4355-909a-54bd348c87cc,4:aa11f5fe-38dd-4bf5-86e3-71d874cdc24c
# Mapa filial:CNPJ da empresa usado para emissao de cobrancas.
PAYIP_COMPANY_TAX_IDS=3:20983885000101
PAYIP_TOKEN_CACHE_FILE=exports/payip/tokens.json
PAYIP_TIMEOUT_SECONDS=30
# Codigo MFA somente para bootstrap manual de sessao. Depois disso, use refresh_token/cache.
PAYIP_MFA_CODE=

BACKUP_OUTPUT_DIR=exports/backups
BACKUP_RETENTION_DAYS=7
BACKUP_ACCESS_SCHEMA=bot_access
BACKUP_INCLUDE_VOLUMES=0
BACKUP_EXTERNAL_DIR=
STACK_MONITOR_MIN_FREE_GB=5
STACK_ALERT_NUMBERS=
STACK_ALERT_COOLDOWN_MINUTES=30
STACK_ALERT_STATE_FILE=exports/monitoring/stack_alert_state.json
